# Start with testnet. Mainnet: CHAIN_ID=56 and the fixed BSC USDT contract.
CHAIN_ID=97
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Deploy your TestUSDT contract first; this is NOT the mainnet USDT contract.
TOKEN_CONTRACT=
API_KEY=
# Public external branch at m/44'/60'/0'/0; never a private key or seed.
WALLET_XPUB=
CONFIRMATIONS=15
POLL_SECONDS=10
SCAN_BATCH_BLOCKS=500
INVOICE_TTL_SECONDS=3600
DATABASE_PATH=/data/payments.sqlite
LISTEN_ADDR=:8080
# Optional fixed destination. Not accepted from individual invoice requests.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Optional automatic collection. Main wallet's private key is NOT needed.
AUTO_SWEEP_ENABLED=false
MAIN_WALLET_ADDRESS=
SWEEP_SEED_FILE=/run/secrets/deposit.seed
GAS_PRIVATE_KEY_FILE=/run/secrets/gas.key
# Host files mounted only by the signer. Owner must be UID 10001, mode 0400/0600.
SWEEP_SEED_HOST_PATH=./secrets/deposit.seed
GAS_KEY_HOST_PATH=./secrets/gas.key
SWEEP_POLL_SECONDS=10
SWEEP_TOKEN_GAS_LIMIT=100000
SWEEP_MAX_GAS_PRICE_WEI=10000000000
SWEEP_MAX_TOPUP_WEI=2000000000000000
# 0 sweeps any positive confirmed deposit, including partial/late payments.
SWEEP_MIN_AMOUNT=0
