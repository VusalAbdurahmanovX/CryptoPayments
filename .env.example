# Start with testnet. Mainnet: CHAIN_ID=56 and the fixed BSC USDT contract.
CHAIN_ID=97
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Deploy your TestUSDT contract first; this is NOT the mainnet USDT contract.
TOKEN_CONTRACT=
API_KEY=
# Public external branch at m/44'/60'/0'/0; never a private key or seed.
WALLET_XPUB=
CONFIRMATIONS=15
POLL_SECONDS=10
SCAN_BATCH_BLOCKS=500
INVOICE_TTL_SECONDS=3600
DATABASE_PATH=/data/payments.sqlite
LISTEN_ADDR=:8080
# Optional fixed destination. Not accepted from individual invoice requests.
WEBHOOK_URL=
WEBHOOK_SECRET=
